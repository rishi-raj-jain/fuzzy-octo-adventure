# Neon Postgres connection string (the Vercel Neon integration sets this automatically).
# Optional: without it runs still work, but nothing is saved and images are inlined in the response.
DATABASE_URL=

# Google sign-in (Better Auth). Required in production; without them `next dev` runs with sign-in off.
# Redirect URI to register in Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app, e.g. https://navprobe.vercel.app (http://localhost:3000 locally)
BETTER_AUTH_URL=
# Who may sign in (exact domain match, comma separated)
ALLOWED_EMAIL_DOMAINS=launchfa.st,neon.com

# Optional: lets scripts/CI call the API with `Authorization: Bearer <key>` (or `x-api-key`) instead of a session.
NAVPROBE_API_KEY=

# Optional: hard cap for a single run, in seconds. Keep it below the route's maxDuration (300).
MAX_RUN_SECONDS=270

# Optional: allow navigating to localhost / private IPs (always allowed in `next dev`).
ALLOW_PRIVATE_NETWORKS=false

# Optional: use a specific local Chrome/Chromium binary instead of auto-detection.
CHROME_EXECUTABLE_PATH=

# Optional: route the local browser through an HTTP proxy, e.g. http://127.0.0.1:8080
CHROME_PROXY_SERVER=
